# Data pipeline image: GCC + Clang + common build deps + Ghidra (headless).
# Build for x86-64 so every binary in the dataset shares one architecture:
#   docker build --platform linux/amd64 -f docker/Dockerfile.pipeline -t fnname-pipeline .
FROM ubuntu:24.04

ARG GHIDRA_VERSION=11.2.1
ARG GHIDRA_DATE=20241105
ENV DEBIAN_FRONTEND=noninteractive \
    GHIDRA_HOME=/opt/ghidra

# libharfbuzz/freetype/fontconfig: Ghidra measures fonts even headless, and the
# -headless JDK doesn't pull them in (UnsatisfiedLinkError in libfontmanager.so).
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential gcc clang lld binutils make cmake ninja-build pkg-config \
        autoconf automake libtool autopoint gettext bison flex texinfo gperf m4 \
        git ca-certificates curl unzip rsync wget xz-utils \
        libncurses-dev libevent-dev zlib1g-dev libreadline-dev \
        openjdk-21-jdk-headless python3 python3-venv python3-pip \
        libharfbuzz0b libfreetype6 fontconfig fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL -o /tmp/ghidra.zip \
        "https://github.com/NationalSecurityAgency/ghidra/releases/download/Ghidra_${GHIDRA_VERSION}_build/ghidra_${GHIDRA_VERSION}_PUBLIC_${GHIDRA_DATE}.zip" \
    && unzip -q /tmp/ghidra.zip -d /opt && mv /opt/ghidra_${GHIDRA_VERSION}_PUBLIC ${GHIDRA_HOME} && rm /tmp/ghidra.zip

WORKDIR /app
COPY requirements.txt .
RUN python3 -m venv /venv && /venv/bin/pip install --no-cache-dir -r requirements.txt
ENV PATH=/venv/bin:$PATH
COPY . .
